  cohorts = list(startup = startup, intake_2 = intake_2),
  entry_wave = c(startup = 1, intake_2 = 2),
  schedule = rbind(
    transform(startup_schedule, cohort = "startup"),
    data.frame(
      cohort = "intake_2", panel = 1, wave = 1:3,
      active = c(FALSE, TRUE, TRUE)
    )
  )
)
program

execute(program, wave = 2)

