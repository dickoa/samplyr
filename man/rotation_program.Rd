  wave = rep(1:3, each = 2),
  active = c(TRUE, TRUE, TRUE, FALSE, FALSE, TRUE)
)
startup <- sampling_design() |>
  draw(n = 40) |>
  execute(frame_1, seed = 1, panels = startup_schedule)

